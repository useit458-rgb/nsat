# NSAT Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-use-a-strong-random-key
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Security and Scan Limits
MAX_TARGETS_PER_SCAN=1
MAX_PORTS_PER_SCAN=1000
DEFAULT_SCAN_TIMEOUT=60
MAX_SCAN_TIMEOUT=300
ALLOW_PUBLIC_TARGETS=false
RATE_LIMIT_DELAY=0.05

# External Tool Executables (leave blank or specify custom paths)
NMAP_PATH=nmap
LYNIS_PATH=lynis

# Database
DATABASE_URL=sqlite:///instance/nsat.db
